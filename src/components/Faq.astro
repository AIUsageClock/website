---
import type { Messages } from '../i18n';

interface Props {
  m: Messages['faq'];
}
const { m } = Astro.props;

/** Display order. Only `unsigned` gets an id: the download card links to #unsigned. */
const order = ['howResets', 'data', 'affiliation', 'unsigned', 'platforms', 'free'] as const;
---

<section class="sec" id="faq" aria-labelledby="faq-title">
  <div class="wrap-b">
    <header class="sec-h">
      <p class="lab">{m.label}</p>
      <h2 id="faq-title">{m.heading}</h2>
    </header>
    <div class="faq2">
      {
        order.map((key) => {
          const item = m.items[key];
          return (
            <div class="qa" id={key === 'unsigned' ? 'unsigned' : undefined}>
              <h3>{item.q}</h3>
              {item.parasHtml.map((p) => (
                <p set:html={p} />
              ))}
              {item.listHtml.length > 0 && (
                <ul>
                  {item.listHtml.map((li) => (
                    <li set:html={li} />
                  ))}
                </ul>
              )}
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .faq2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(32px,4vw,52px) clamp(32px,6vw,80px)}
  .qa h3{font:600 clamp(1.2rem,1.9vw,1.4rem)/1.2 var(--f-serif);letter-spacing:-.015em;padding-top:16px;border-top:2px solid var(--rule-strong)}
  .qa p,.qa ul{margin-top:12px;color:var(--ink-2);font-size:1rem}
  .qa p + p,.qa ul + p{margin-top:10px}
  .qa ul{display:grid;gap:8px}
  .qa li{padding-left:18px;position:relative}
  .qa li::before{content:"";position:absolute;left:0;top:.8em;width:8px;height:2px;background:var(--orange)}

  @media (max-width:860px){
    .faq2{grid-template-columns:minmax(0,1fr)}
  }

  /* Chinese (see global.css) */
  :global(:root:lang(zh)) .qa h3{letter-spacing:0;line-height:1.4}
</style>
