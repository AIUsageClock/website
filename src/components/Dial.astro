<style>
  .dial{position:absolute;left:50%;top:50%;width:min(1200px,160vw);height:auto;aspect-ratio:1;transform:translate(-50%,-50%);pointer-events:none;color:var(--ink)}
  .dial circle{fill:none;stroke:currentColor;stroke-opacity:calc(.12*var(--dial-k))}
  .dial .mn{stroke:currentColor;stroke-opacity:calc(.15*var(--dial-k));stroke-width:2;fill:none}
  .dial .mj{stroke:currentColor;stroke-opacity:calc(.24*var(--dial-k));stroke-width:5;stroke-linecap:round;fill:none}
  .dial .arc{stroke:var(--orange);stroke-width:5;stroke-linecap:round;fill:none;opacity:.6}
  @media (prefers-reduced-motion:no-preference){
    .dial .mn,.dial .mj{animation:fade 1.8s ease-out both}
    .dial .arc{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 2.4s .35s cubic-bezier(.3,.7,.2,1) forwards}
  }
  @keyframes fade{from{opacity:0}to{opacity:1}}
  @keyframes draw{to{stroke-dashoffset:0}}
</style>
