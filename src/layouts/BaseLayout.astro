---
// Fonts are self-hosted from the Fontsource packages: Vite copies the .woff2 files into dist/_astro,
// so the page never contacts Google Fonts or any other font host.
// Fraunces uses the opsz (optical size) axis in roman and italic; Inter only needs weight.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource-variable/inter/wght.css';
// The CJK heading fonts are imported as URLs ("?url"), not as plain CSS imports. A plain import would be
// bundled into the one stylesheet that every language shares (all languages are one route), so the English
// page would carry the Chinese and Japanese @font-face rules too. A URL import still has Vite process the CSS and copy the
// .woff2 chunks into dist/_astro, but leaves it to the template below to link only the stylesheet a page needs.
import notoSerifTcCss from '@fontsource-variable/noto-serif-tc/index.css?url';
import notoSerifScCss from '@fontsource-variable/noto-serif-sc/index.css?url';
import notoSerifJpCss from '@fontsource-variable/noto-serif-jp/index.css?url';
// The hero tagline of the Chinese and Japanese pages has its own font: a WOFF2 holding only the characters of that
// language's two tagline lines (made by scripts/make-hero-fonts.mjs). "?no-inline" keeps Vite from turning a file under 4 KB
// into a data: URI, which a <link rel="preload"> could not use; the file is copied to dist/_astro with a hash in its name.
import heroFontTc from '../assets/fonts/hero/uoqmunthenkhung-hero.woff2?no-inline';
import heroFontSc from '../assets/fonts/hero/longcang-hero.woff2?no-inline';
import heroFontJa from '../assets/fonts/hero/reggaeone-hero.woff2?no-inline';
import '../styles/global.css';
import { LOCALES, DEFAULT_LOCALE, getLocale } from '../i18n/locales';
import { t } from '../i18n';
import { SITE_NAME } from '../site';

interface Props {
  title: string;
  description: string;
  /** Value for <html lang>. */
  htmlLang: string;
  noindex?: boolean;
  /** Path of this page, e.g. "/en/". Sets canonical and og:url. Leave out for pages that should have neither. */
  canonicalPath?: string;
  /** Path of this page under each locale prefix ("" for the home page). Sets the hreflang alternates plus x-default. */
  alternatePath?: string;
  /** Locale code of the page's language (one of the codes in i18n/locales.ts). Picks the link-preview image and og:locale. Defaults to English. */
  locale?: string;
}

const { title, description, htmlLang, noindex = false, canonicalPath, alternatePath, locale = DEFAULT_LOCALE } = Astro.props;

// Fonts for Chinese and Japanese pages, chosen by the <html lang> the page actually carries, the same value the
// :lang() rules in global.css and Hero.astro key on: the heading stylesheet (Noto Serif) and the hero tagline font file.
// English and European-language pages, and any page that falls back to English, get none.
const cjk = /^zh-hant/i.test(htmlLang)
  ? { headingCss: notoSerifTcCss, heroFont: heroFontTc }
  : /^zh-hans/i.test(htmlLang)
    ? { headingCss: notoSerifScCss, heroFont: heroFontSc }
    : /^ja(-|$)/i.test(htmlLang)
      ? { headingCss: notoSerifJpCss, heroFont: heroFontJa }
      : undefined;
// The hero tagline font is declared under one name, "Hero Tagline", which Hero.astro puts in the font stack of the tagline.
// Only the page of its language declares and preloads it. It has a single weight (400): see Hero.astro.
const heroFontFace = cjk
  ? `@font-face{font-family:"Hero Tagline";font-style:normal;font-weight:400;font-display:swap;src:url(${cjk.heroFont}) format("woff2")}`
  : undefined;

// Link preview: one 1200x630 image per language (public/og/<code>.png, made by scripts/render-og.mjs).
const loc = getLocale(locale);
const ogImage = new URL(`/og/${loc.code}.png`, Astro.site).href;
const ogAlt = t(loc.code).meta.ogAlt;
const ogLocaleAlternates = LOCALES.filter((l) => l.code !== loc.code).map((l) => l.ogLocale);

const canonical = canonicalPath === undefined ? undefined : new URL(canonicalPath, Astro.site).href;
const alternates =
  alternatePath === undefined
    ? []
    : [
        ...LOCALES.map((l) => ({
          hreflang: l.hreflang,
          href: new URL(`/${l.code}/${alternatePath}`, Astro.site).href,
        })),
        { hreflang: 'x-default', href: new URL('/', Astro.site).href },
      ];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={loc.ogLocale} />
    {ogLocaleAlternates.map((l) => <meta property="og:locale:alternate" content={l} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1714" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {cjk && <link rel="preload" as="font" type="font/woff2" href={cjk.heroFont} crossorigin />}
    {heroFontFace && <style is:inline set:html={heroFontFace} />}
    {cjk && <link rel="stylesheet" href={cjk.headingCss} />}
    <script is:inline>
      /* Runs before the page is painted: mark the page as JS-capable and apply a saved theme choice (if any),
         so the page never flashes the wrong theme. Without a saved choice the CSS follows the system. */
      (function () {
        var d = document, r = d.documentElement, t = null;
        r.classList.add('js');
        try { t = localStorage.getItem('aiuc-theme'); } catch (e) { t = null; }
        if (t === 'light' || t === 'dark') {
          r.setAttribute('data-theme', t);
          var ms = d.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < ms.length; i++) ms[i].setAttribute('content', t === 'dark' ? '#1a1714' : '#f7f4ee');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
