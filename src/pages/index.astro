---
// Root "/": picks a language and redirects. It is a real page so that crawlers see links. Without JavaScript, the <noscript>
// meta refresh sends the visitor to /en/. The links on this page are the fallback for when the script's redirect fails or is blocked.
import { Image } from 'astro:assets';
import icon from '../assets/aiusageclockicon.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import { LOCALES } from '../i18n/locales';
import { t } from '../i18n';
import { SITE_NAME } from '../site';

const m = t('en');
const codes = LOCALES.map((l) => l.code);
---

<BaseLayout title={m.root.title} description={m.meta.description} htmlLang="en" canonicalPath="/" alternatePath="">
  <Fragment slot="head">
    <noscript><meta http-equiv="refresh" content="0;url=/en/" /></noscript>
    <script is:inline data-codes={codes.join(',')}>
      /* Where to go, in order: 1) the language saved by the language menu (aiuc-lang), if the site has it,
         2) the browser's language list, in the visitor's order: the first entry the site can serve wins.
            A tag is first compared whole (lower case, "_" turned into "-") with the site's codes, so a site code that carries a
            region (zh-tw today, a future pt-br) is met by zh-TW or pt-BR before anything is simplified.
            Chinese that is not an exact code is told apart by script and region (Traditional: zh-TW, zh-HK, zh-MO, Hant -> zh-tw;
            Simplified or plain zh -> zh-cn); every other language is matched by its base subtag against the site's codes
            (en, ja, es, fr, de), so es-MX, es-ES and es-419 all go to es, fr-CA to fr, de-AT to de. A language the site does not
            have (pt-BR today) is skipped and the next entry is tried,
         3) English. */
      (function () {
        var codes = (document.currentScript && document.currentScript.getAttribute('data-codes') || 'en').split(',');
        function known(code) { return codes.indexOf(code) !== -1; }
        function go(code) { location.replace('/' + code + '/'); }
        function pick(tag) {
          var full = String(tag || '').toLowerCase().replace(/_/g, '-');
          var p = full.split('-');
          if (known(full)) return full;
          if (p[0] === 'zh') {
            if (p.indexOf('hant') !== -1) return 'zh-tw';
            if (p.indexOf('hans') !== -1) return 'zh-cn';
            if (p.indexOf('tw') !== -1 || p.indexOf('hk') !== -1 || p.indexOf('mo') !== -1) return 'zh-tw';
            return 'zh-cn';
          }
          return p[0] && known(p[0]) ? p[0] : null;
        }
        var saved = null;
        try { saved = localStorage.getItem('aiuc-lang'); } catch (e) { saved = null; }
        if (saved && known(saved)) { go(saved); return; }
        var tags = (navigator.languages && navigator.languages.length) ? navigator.languages : [navigator.language || ''];
        for (var i = 0; i < tags.length; i++) {
          var code = pick(tags[i]);
          if (code && known(code)) { go(code); return; }
        }
        go('en');
      })();
    </script>
  </Fragment>

  <main class="pick wrap-b narrow" id="main">
    <Image src={icon} width={216} height={216} format="png" alt="" loading="eager" />
    <h1>{SITE_NAME}</h1>
    {/* The page is not tied to one language: English asks the question, and every language is offered by its own name. */}
    <p class="lab">{m.root.choose}</p>
    <ul>
      {
        LOCALES.map((l) => (
          <li>
            <a class="btn-line" href={`/${l.code}/`} lang={l.htmlLang} hreflang={l.hreflang}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>

<style>
  .pick{display:flex;flex-direction:column;align-items:center;text-align:center;padding-block:clamp(72px,16vw,160px)}
  .pick :global(img){width:72px;height:72px}
  .pick h1{margin-top:20px;font:600 clamp(2rem,6vw,3.2rem)/1.05 var(--f-serif);letter-spacing:-.03em}
  .pick .lab{margin-top:28px;line-height:1.8}
  .pick ul{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;max-width:34em;margin-top:20px}
</style>
