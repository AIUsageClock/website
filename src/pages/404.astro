---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { t } from '../i18n';

const m = t('en');
---

<BaseLayout title={m.notFound.title} description={m.meta.description} htmlLang="en" noindex>
  <a class="skip" href="#main">{m.a11y.skip}</a>
  <SiteHeader lang="en" m={m} brandHref="/en/" />
  <main id="main" class="nf wrap-b narrow">
    <p class="lab">404</p>
    <h1>{m.notFound.heading}</h1>
    <p class="body">{m.notFound.body}</p>
    <a class="btn-ink" href="/en/">{m.notFound.back}</a>
  </main>
  <SiteFooter m={m.footer} brandHref="/en/" />
</BaseLayout>

<style>
  .nf{display:flex;flex-direction:column;align-items:center;text-align:center;padding-block:clamp(64px,14vw,144px)}
  .nf h1{margin-top:16px;font:600 clamp(2.4rem,7vw,5rem)/1 var(--f-serif);letter-spacing:-.04em;text-wrap:balance}
  .nf .body{margin-top:20px;max-width:30em;color:var(--ink-2);text-wrap:pretty}
  .nf .btn-ink{margin-top:32px}
</style>
