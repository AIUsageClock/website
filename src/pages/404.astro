---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { LOCALES, DEFAULT_LOCALE, getLocale } from '../i18n/locales';
import { t } from '../i18n';
import { SITE_NAME } from '../site';

// This page is one file for every address, so it cannot know the visitor's language:
// the default language fills the page chrome, and every language's short text is shown.
const m = t(DEFAULT_LOCALE);
const others = LOCALES.filter((l) => l.code !== DEFAULT_LOCALE).map((l) => ({ locale: l, m: t(l.code) }));
const all = LOCALES.map((l) => ({ locale: l, m: t(l.code) }));
const title = `${all.map((x) => x.m.notFound.heading).join(' · ')} — ${SITE_NAME}`;
---

<BaseLayout title={title} description={m.meta.description} htmlLang={getLocale(DEFAULT_LOCALE).htmlLang} noindex>
  <a class="skip" href="#main">{m.a11y.skip}</a>
  {/* No language is "current" here, so the language menu ticks none and every entry leads to a home page. */}
  <SiteHeader lang="" m={m} brandHref="/" />
  <main id="main" class="nf wrap-b narrow">
    <p class="lab">404</p>
    <h1>{m.notFound.heading}</h1>
    <p class="body">{m.notFound.body}</p>
    {
      others.map((o) => (
        <p class="body" lang={o.locale.htmlLang}>
          <strong>{o.m.notFound.heading}。</strong>
          {o.m.notFound.body}
        </p>
      ))
    }
    {/* "/" is the language-picking redirect page, so each visitor lands on the home page in their own language. */}
    <a class="btn-ink" href="/">
      {
        all.map((x, i) => (
          <>
            {i > 0 && <span aria-hidden="true">·</span>}
            <span lang={x.locale.htmlLang}>{x.m.notFound.back}</span>
          </>
        ))
      }
    </a>
  </main>
  <SiteFooter m={m.footer} brandHref="/" />
</BaseLayout>

<style>
  .nf{display:flex;flex-direction:column;align-items:center;text-align:center;padding-block:clamp(64px,14vw,144px)}
  .nf h1{margin-top:16px;font:600 clamp(2.4rem,7vw,5rem)/1 var(--f-serif);letter-spacing:-.04em;text-wrap:balance}
  .nf .body{margin-top:20px;max-width:30em;color:var(--ink-2);text-wrap:pretty}
  .nf .btn-ink{margin-top:32px}
  .nf .btn-ink span{white-space:nowrap}
  @media (max-width:560px){
    /* three languages side by side no longer fit on one line: stack them instead of letting a label break mid-word */
    .nf .btn-ink{flex-direction:column;gap:2px;padding-block:12px;border-radius:24px;line-height:1.3}
    .nf .btn-ink [aria-hidden="true"]{display:none}
  }
</style>
