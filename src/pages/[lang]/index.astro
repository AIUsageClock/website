---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import Hero from '../../components/Hero.astro';
import Story from '../../components/Story.astro';
import Services from '../../components/Services.astro';
import ResetTimeline from '../../components/ResetTimeline.astro';
import Faq from '../../components/Faq.astro';
import DownloadCard from '../../components/DownloadCard.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { LOCALES, getLocale } from '../../i18n/locales';
import { t, isComplete, htmlLangFor } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code } }));
}

const lang = getLocale(Astro.params.lang ?? '').code;
const m = t(lang);
---

<BaseLayout
  title={m.meta.title}
  description={m.meta.description}
  htmlLang={htmlLangFor(lang)}
  noindex={!isComplete(lang)}
  canonicalPath={`/${lang}/`}
  alternatePath=""
>
  <a class="skip" href="#main">{m.a11y.skip}</a>
  <SiteHeader lang={lang} m={m} />
  <main id="main">
    <Hero m={m.hero} />
    <Story m={m.stories} />
    <Services m={m.services} />
    <ResetTimeline m={m.resets} />
    <Faq m={m.faq} />
    <DownloadCard m={m.download} />
  </main>
  <SiteFooter m={m.footer} />
</BaseLayout>
